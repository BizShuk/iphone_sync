{
  "name": "iphone-sync",
  "version": "0.0.0",
  "private": true,
  "description": "Local Wi-Fi Photo & Video Sync from iPhone to Mac and Windows",
  "scripts": {
    "dev": "npx npm-run-all --parallel dev:*",
    "dev:ios": "./scripts/run-simulator.sh",
    "dev:mac": "./scripts/run-server.sh",
    "dev:windows": "cd apps/windows && npm run build && npm start",

    "test": "npx npm-run-all --parallel test:*",
    "test:swift": "swift test --package-path packages/SyncCore",
    "test:windows": "cd packages/SyncCore.Windows && npm test && cd ../../apps/windows && npm test",

    "build": "npx npm-run-all --parallel build:*",
    "build:ios": "./scripts/run-iphone.sh --build-only",
    "build:mac": "./scripts/package-mac.sh && ./scripts/stage-mac-download.sh",
    "build:windows": "cd packages/SyncCore.Windows && npm ci && npm run build && cd ../../apps/windows && npm ci && npm run build && npm run dist",

    "deploy": "npx npm-run-all --parallel deploy:*",
    "deploy:ios": "./scripts/run-iphone.sh",
    "deploy:mac": "./scripts/run-mac.sh",

    "release": "npx npm-run-all --parallel release:*",
    "release:ios": "./scripts/release.sh",
    "release:site": "./scripts/release-store.sh",

    "lint": "npx npm-run-all --parallel lint:*",
    "lint:swift": "xcodegen generate && xcodebuild -project iPhoneSync.xcodeproj -scheme iPhoneSyncMac -destination 'platform=macOS' build CODE_SIGNING_ALLOWED=NO",
    "lint:windows": "cd packages/SyncCore.Windows && npm run lint",

    "clean": "npx npm-run-all --parallel clean:*",
    "clean:build": "rm -rf build dist",
    "clean:swift": "swift package --package-path packages/SyncCore clean",
    "clean:windows": "rm -rf packages/SyncCore.Windows/dist apps/windows/dist apps/windows/release",

    "destroy": "npx npm-run-all --parallel destroy:*",
    "destroy:mac": "pkill -f 'iPhone Sync' || true",
    "destroy:windows": "pkill -f 'iphonesync-windows' || true",

    "run:verify": "./scripts/verify.sh",
    "run:verify-windows": "./scripts/verify-windows.sh"
  }
}
