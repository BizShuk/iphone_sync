{
  "name": "@iphonesync/synccore-windows",
  "version": "1.0.0",
  "private": true,
  "description": "iPhone Sync Windows 11 receiver protocol + receiver logic (TypeScript port of Swift SyncCore/MacReceiverKit).",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./protocol": {
      "types": "./dist/protocol/index.d.ts",
      "import": "./dist/protocol/index.js"
    },
    "./crypto": {
      "types": "./dist/crypto/index.d.ts",
      "import": "./dist/crypto/index.js"
    },
    "./discovery": {
      "types": "./dist/discovery/index.d.ts",
      "import": "./dist/discovery/index.js"
    },
    "./pairing": {
      "types": "./dist/pairing/index.d.ts",
      "import": "./dist/pairing/index.js"
    },
    "./receiver": {
      "types": "./dist/receiver/index.d.ts",
      "import": "./dist/receiver/index.js"
    },
    "./persistence": {
      "types": "./dist/persistence/index.d.ts",
      "import": "./dist/persistence/index.js"
    },
    "./logging": {
      "types": "./dist/logging/index.d.ts",
      "import": "./dist/logging/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "better-sqlite3": "^11.3.0",
    "dns-packet": "^5.6.1",
    "multicast-dns": "^7.2.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/dns-packet": "^5.6.5",
    "@types/node": "^22.7.5",
    "typescript": "^5.6.3",
    "vitest": "^2.1.3"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
