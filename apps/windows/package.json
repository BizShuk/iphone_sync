{
  "name": "iphonesync-windows",
  "version": "1.0.0",
  "private": true,
  "description": "iPhone Sync Windows 11 desktop receiver (Electron + Node.js).",
  "author": "shuk",
  "license": "UNLICENSED",
  "main": "dist/main/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "start": "electron .",
    "test": "vitest run",
    "postinstall": "node scripts/copy-sync-core.js",
    "dist": "electron-builder --win nsis portable",
    "dist:nsis": "electron-builder --win nsis",
    "dist:portable": "electron-builder --win portable"
  },
  "dependencies": {
    "@iphonesync/synccore-windows": "file:../../packages/SyncCore.Windows",
    "better-sqlite3": "^11.3.0",
    "dns-packet": "^5.6.1",
    "multicast-dns": "^7.2.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^22.7.5",
    "electron": "^32.1.2",
    "electron-builder": "^25.0.5",
    "typescript": "^5.6.3",
    "vitest": "^2.1.3"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
